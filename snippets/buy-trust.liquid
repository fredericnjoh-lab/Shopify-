{%- comment -%}
  Quiet trust row under Add to cart — Icon-style hierarchy, FredJo voice.
  Blocking stylesheet: ATC + buy area are above-the-fold on PDP (#44 defer hurt LCP/CLS).
{%- endcomment -%}
{{ 'component-buy-trust.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Payment icons under ATC. Secure line lives in cart-reassurance (3-line trust).
{%- endcomment -%}
<div class="buy-trust buy-trust--icons-only">
  {%- unless shop.enabled_payment_types == empty -%}
    <ul class="buy-trust__icons" aria-label="{{ 'products.product.secure_checkout' | t }}">
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag }}</li>
      {%- endfor -%}
    </ul>
  {%- endunless -%}
</div>
