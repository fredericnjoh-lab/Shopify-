{%- comment -%}
  Quiet trust row under Add to cart — Icon-style hierarchy, FredJo voice.
{%- endcomment -%}
{{ 'component-buy-trust.css' | asset_url | stylesheet_tag }}

<div class="buy-trust">
  <p class="buy-trust__label">
    <span class="buy-trust__lock" aria-hidden="true">
      <svg width="12" height="14" viewBox="0 0 12 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9.5 5.5V4a3.5 3.5 0 1 0-7 0v1.5H1.5A1.5 1.5 0 0 0 0 7v5A1.5 1.5 0 0 0 1.5 13.5h9A1.5 1.5 0 0 0 12 12V7a1.5 1.5 0 0 0-1.5-1.5H9.5Zm-5.5-1.5a2 2 0 1 1 4 0v1.5h-4V4Z" fill="currentColor"/>
      </svg>
    </span>
    {{ 'products.product.secure_checkout' | t }}
  </p>
  {%- unless shop.enabled_payment_types == empty -%}
    <ul class="buy-trust__icons" aria-label="{{ 'products.product.secure_checkout' | t }}">
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag }}</li>
      {%- endfor -%}
    </ul>
  {%- endunless -%}
</div>
