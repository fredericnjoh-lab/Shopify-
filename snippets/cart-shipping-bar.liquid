{%- comment -%}
  Free-shipping threshold progress for cart drawer and cart page.
  Threshold is 100 in shop currency (USD). JS converts to the
  active presentment currency via Shopify.currency.rate.
{%- endcomment -%}
{%- assign threshold_shop_cents = 10000 -%}
<div
  class="cart-shipping-bar"
  data-cart-shipping-bar
  data-threshold-shop="{{ threshold_shop_cents }}"
  data-shop-currency="{{ shop.currency }}"
  data-cart-total="{{ cart.total_price }}"
  data-cart-count="{{ cart.item_count }}"
  data-remaining-template="{{ 'cart.general.shipping_bar_remaining_html' | t | escape }}"
  data-qualified-text="{{ 'cart.general.shipping_bar_qualified' | t | escape }}">
  <p class="cart-shipping-bar__message" data-cart-shipping-message>
    {{ 'cart.general.reassurance_shipping' | t }}
  </p>
  <div class="cart-shipping-bar__track" aria-hidden="true">
    <span class="cart-shipping-bar__fill" data-cart-shipping-fill style="width: 0%;"></span>
  </div>
</div>

{%- style -%}
  .cart-shipping-bar {
    margin: 0 0 14px;
    padding: 12px 0 0;
  }
  .cart-shipping-bar__message {
    margin: 0 0 10px;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.4;
    opacity: 0.9;
  }
  .cart-shipping-bar__track {
    height: 2px;
    background: rgba(10, 10, 10, 0.12);
    overflow: hidden;
  }
  .cart-shipping-bar__fill {
    display: block;
    height: 100%;
    width: 0;
    background: #B8975A;
    transition: width 0.35s ease;
  }
  .drawer__footer .cart-shipping-bar {
    margin-bottom: 12px;
  }
{%- endstyle -%}
