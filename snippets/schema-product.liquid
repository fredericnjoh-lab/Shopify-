{%- comment -%}
  Product JSON-LD for PDPs. AggregateRating only when Judge.me / Shopify
  review metafields report reviewCount > 0 and a non-zero rating.
{%- endcomment -%}
{%- liquid
  assign schema_variant = current_variant
  if schema_variant == blank
    assign schema_variant = product.selected_or_first_available_variant
  endif

  assign days_price_valid_until = 10 | times: 86400
  assign gtin_option = 'gtin'
  assign is_barcode_available = false
  assign is_valid_gtin_length = false
  if schema_variant.barcode != blank
    assign is_barcode_available = true
    assign gtin_string_length = schema_variant.barcode | size
    if gtin_string_length == 8 or gtin_string_length == 12 or gtin_string_length == 13 or gtin_string_length == 14
      assign is_valid_gtin_length = true
      assign gtin_option = gtin_option | append: gtin_string_length
    endif
  endif

  assign rating_value = blank
  assign review_count = 0
  assign best_rating = 5
  assign worst_rating = 1

  # Shopify standard reviews metafields (populated by Judge.me)
  if product.metafields.reviews.rating.value != blank
    if product.metafields.reviews.rating.value.rating != blank
      assign rating_value = product.metafields.reviews.rating.value.rating
    else
      assign rating_value = product.metafields.reviews.rating.value
    endif
    if product.metafields.reviews.rating.value.scale_max != blank
      assign best_rating = product.metafields.reviews.rating.value.scale_max
    endif
    if product.metafields.reviews.rating.value.scale_min != blank
      assign worst_rating = product.metafields.reviews.rating.value.scale_min
    endif
  endif

  if product.metafields.reviews.rating_count.value != blank
    assign review_count = product.metafields.reviews.rating_count.value | plus: 0
  elsif product.metafields.reviews.rating_count != blank
    assign review_count = product.metafields.reviews.rating_count | plus: 0
  endif

  # Judge.me badge fallback when standard metafields are empty
  if review_count == 0 and product.metafields.judgeme.badge != blank
    assign jm_badge = product.metafields.judgeme.badge | strip
    assign jm_avg = 0
    assign jm_count = 0
    assign jm_avg_parts = jm_badge | split: 'data-average-rating="'
    if jm_avg_parts.size > 1
      assign jm_avg = jm_avg_parts[1] | split: '"' | first | plus: 0
    else
      assign jm_avg_parts = jm_badge | split: "data-average-rating='"
      if jm_avg_parts.size > 1
        assign jm_avg = jm_avg_parts[1] | split: "'" | first | plus: 0
      endif
    endif
    assign jm_count_parts = jm_badge | split: 'data-number-of-reviews="'
    if jm_count_parts.size > 1
      assign jm_count = jm_count_parts[1] | split: '"' | first | plus: 0
    else
      assign jm_count_parts = jm_badge | split: "data-number-of-reviews='"
      if jm_count_parts.size > 1
        assign jm_count = jm_count_parts[1] | split: "'" | first | plus: 0
      endif
    endif
    if jm_count > 0 and jm_avg > 0
      assign review_count = jm_count
      assign rating_value = jm_avg
    endif
  endif

  assign show_aggregate_rating = false
  if review_count > 0 and rating_value != blank
    assign rating_as_number = rating_value | plus: 0
    if rating_as_number > 0
      assign show_aggregate_rating = true
    endif
  endif

  assign product_image = product.featured_media.preview_image
  if product_image == blank
    assign product_image = product.featured_image
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ canonical_url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "url": {{ canonical_url | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  {%- if schema_variant.sku != blank -%}
  "sku": {{ schema_variant.sku | json }},
  {%- endif -%}
  {%- if is_barcode_available and is_valid_gtin_length -%}
  "{{ gtin_option }}": {{ schema_variant.barcode | json }},
  "productId": {{ schema_variant.barcode | json }},
  {%- elsif is_barcode_available -%}
  "mpn": {{ schema_variant.barcode | json }},
  "productId": {{ schema_variant.barcode | json }},
  {%- endif -%}
  {%- if product_image != blank -%}
  "image": {
    "@type": "ImageObject",
    "url": {{ product_image | image_url: width: 1024 | prepend: 'https:' | json }},
    "image": {{ product_image | image_url: width: 1024 | prepend: 'https:' | json }},
    "name": {{ product.title | json }},
    "width": 1024,
    "height": 1024
  },
  {%- endif -%}
  {%- if show_aggregate_rating -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating_value | json }},
    "reviewCount": {{ review_count | json }},
    "bestRating": {{ best_rating | json }},
    "worstRating": {{ worst_rating | json }}
  },
  {%- endif -%}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      {%- if variant.sku != blank -%}
      "sku": {{ variant.sku | json }},
      {%- endif -%}
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.00 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "priceValidUntil": "{{ 'now' | date: '%s' | plus: days_price_valid_until | date: '%Y-%m-%d' }}",
      "url": {{ shop.url | append: variant.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
