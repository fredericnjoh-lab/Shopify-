{% comment %}
  Club Editorial Split — large image on one side, copy on the other.
{% endcomment %}

<section class="club-split club-split--{{ section.settings.image_side }}" data-section-id="{{ section.id }}">
  <div class="club-split__img">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag:
        loading: 'lazy', sizes: '50vw', widths: '600, 900, 1200, 1600',
        alt: section.settings.image.alt | default: section.settings.title,
        class: 'club-split__photo' }}
    {%- else -%}
      <div class="club-split__photo club-split__photo--placeholder" aria-hidden="true"></div>
    {%- endif -%}
  </div>
  <div class="club-split__copy">
    {%- if section.settings.eyebrow != blank -%}
      <div class="club-split__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h3 class="club-split__title">{{ section.settings.title }}</h3>
    {%- if section.settings.body != blank -%}
      <div class="club-split__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.pull_quote != blank -%}
      <p class="club-split__pull">{{ section.settings.pull_quote }}</p>
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #shopify-section-{{ section.id }} .club-split {
    display: grid; min-height: 720px;
    grid-template-columns: 1.1fr 1fr;
  }
  #shopify-section-{{ section.id }} .club-split--right {
    grid-template-areas: "img copy";
    grid-template-columns: 1.1fr 1fr;
  }
  #shopify-section-{{ section.id }} .club-split--left {
    grid-template-areas: "copy img";
    grid-template-columns: 1fr 1.1fr;
  }
  #shopify-section-{{ section.id }} .club-split__img { grid-area: img; position: relative; background: #3a2117; }
  #shopify-section-{{ section.id }} .club-split__copy { grid-area: copy; background: #fff; color: #0a0a0a; padding: 80px; display: flex; flex-direction: column; justify-content: center; gap: 24px; }
  #shopify-section-{{ section.id }} .club-split__photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .club-split__photo--placeholder { background: #3a2117; }
  #shopify-section-{{ section.id }} .club-split__eyebrow {
    font-family: 'Montserrat', sans-serif; font-size: 11px;
    letter-spacing: 0.28em; text-transform: uppercase; color: #b8975a; font-weight: 500;
  }
  #shopify-section-{{ section.id }} .club-split__title {
    font-family: 'Bebas Neue', Impact, sans-serif; line-height: 1;
    font-size: clamp(36px, 4vw, 56px); letter-spacing: 0.04em;
    text-transform: uppercase; margin: 0;
  }
  #shopify-section-{{ section.id }} .club-split__body {
    font-family: 'Montserrat', sans-serif; font-size: 16px;
    line-height: 1.7; max-width: 460px;
  }
  #shopify-section-{{ section.id }} .club-split__body p { margin: 0 0 14px; }
  #shopify-section-{{ section.id }} .club-split__pull {
    font-family: 'Cormorant Garamond', serif; font-style: italic;
    font-size: 18px; color: #6e6e6e; margin: 4px 0 0;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .club-split { grid-template-columns: 1fr !important; grid-template-areas: "img" "copy" !important; }
    #shopify-section-{{ section.id }} .club-split__copy { padding: 60px 28px; }
    #shopify-section-{{ section.id }} .club-split__img { min-height: 60vh; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Club Editorial Split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "image_side", "label": "Image side",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Standard" },
    { "type": "text", "id": "title", "label": "Title", "default": "Heavyweight Cotton, Cut in Paris." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>400 GSM brushed-back fleece. Dropped shoulder, oversized through the body, tapered at the cuff. Every seam triple-stitched. Built to outlast the season — and the next one.</p>" },
    { "type": "text", "id": "pull_quote", "label": "Pull quote (italic)", "default": "Wear it once and it becomes the default." }
  ],
  "presets": [{ "name": "Club Editorial Split", "category": "Club" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
