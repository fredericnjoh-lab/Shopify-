{% comment %}
  Brand Statement Bar — premium rotating message bar
  Replaces the legacy countdown timer with brand-aligned messaging
{% endcomment %}

<div class="brand-statement-bar" data-section-id="{{ section.id }}">
  <div class="brand-statement-bar__inner">
    {% for block in section.blocks %}
      <div class="brand-statement-bar__message" data-index="{{ forloop.index0 }}" {% if forloop.first %}data-active="true"{% endif %} {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="brand-statement-bar__link">
            <span class="brand-statement-bar__text">{{ block.settings.text }}</span>
          </a>
        {% else %}
          <span class="brand-statement-bar__text">{{ block.settings.text }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .brand-statement-bar {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    width: 100%;
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid {{ section.settings.accent_color }};
  }
  .brand-statement-bar__inner {
    position: relative;
    height: {{ section.settings.bar_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
  }
  .brand-statement-bar__message {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
    pointer-events: none;
    width: 100%;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .brand-statement-bar__message[data-active="true"] {
    opacity: 1;
    pointer-events: auto;
  }
  .brand-statement-bar__text {
    font-family: 'Bebas Neue', 'Impact', sans-serif;
    font-size: {{ section.settings.font_size }}px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1;
  }
  .brand-statement-bar__link {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .brand-statement-bar__link:hover {
    color: {{ section.settings.accent_color }};
  }
  @media (max-width: 768px) {
    .brand-statement-bar__text {
      font-size: {{ section.settings.font_size | minus: 2 }}px;
      letter-spacing: 0.1em;
    }
    .brand-statement-bar__inner {
      height: {{ section.settings.bar_height | minus: 4 }}px;
    }
  }
</style>

<script>
  (function() {
    var bar = document.querySelector('.brand-statement-bar[data-section-id="{{ section.id }}"]');
    if (!bar) return;
    var messages = bar.querySelectorAll('.brand-statement-bar__message');
    if (messages.length <= 1) return;
    var current = 0;
    var rotationSpeed = {{ section.settings.rotation_speed | times: 1000 }};
    var paused = false;
    bar.addEventListener('mouseenter', function() { paused = true; });
    bar.addEventListener('mouseleave', function() { paused = false; });
    setInterval(function() {
      if (paused) return;
      messages[current].setAttribute('data-active', 'false');
      current = (current + 1) % messages.length;
      messages[current].setAttribute('data-active', 'true');
    }, rotationSpeed);
  })();
</script>

{% schema %}
{
  "name": "Brand Statement Bar",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F5F4F0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (hover & border)",
      "default": "#B8975A"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height (px)",
      "min": 36,
      "max": 64,
      "step": 2,
      "default": 44
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size (px)",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "header",
      "content": "Rotation"
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Seconds per message",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message text",
          "default": "United by Attitude. Divided by Nothing."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Statement Bar",
      "category": "Header",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "United by Attitude. Divided by Nothing."
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Free worldwide shipping over 100 USD"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Refined in Paris. Worn everywhere."
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "The Culture Doesn't Wait."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "custom.popups"]
  }
}
{% endschema %}
