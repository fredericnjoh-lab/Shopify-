{%- liquid
  assign cols_desktop = section.settings.columns_desktop
  assign cols_mobile = section.settings.columns_mobile
  assign ratio = section.settings.image_ratio
-%}

{%- style -%}
  .community--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .community--{{ section.id }} .community__grid {
    display: grid;
    grid-template-columns: repeat({{ cols_mobile }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }
  .community--{{ section.id }} .community__item {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ ratio }};
    background: #0A0A0A;
  }
  .community--{{ section.id }} .community__item .image-element,
  .community--{{ section.id }} .community__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .community--{{ section.id }} .community__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 12px;
    background: linear-gradient(to top, rgba(10,10,10,0.55), rgba(10,10,10,0) 55%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .community--{{ section.id }} .community__item:hover .community__overlay,
  .community--{{ section.id }} .community__item:focus-within .community__overlay {
    opacity: 1;
  }
  .community--{{ section.id }} .community__handle {
    color: #F5F4F0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .community--{{ section.id }} .community__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  @media (min-width: 769px) {
    .community--{{ section.id }} .community__grid {
      grid-template-columns: repeat({{ cols_desktop }}, 1fr);
    }
  }
{%- endstyle -%}

{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="community community--{{ section.id }} page-width">
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="section-header">
      {%- if section.settings.title != blank -%}
        <h2 class="section-header__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="section-header__subtext rte">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="community__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign link_url = block.settings.link
          if block.settings.product != blank
            assign link_url = block.settings.product.url
          endif
        -%}
        <div class="community__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- render 'image-element',
              img: block.settings.image,
              widths: '360, 540, 720, 900',
              classes: 'community__image',
              sizeVariable: '360px',
              fallback: '50vw'
            -%}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if block.settings.handle != blank -%}
            <div class="community__overlay">
              <span class="community__handle">{{ block.settings.handle | escape }}</span>
            </div>
          {%- endif -%}

          {%- if link_url != blank -%}
            <a
              href="{{ link_url }}"
              class="community__link"
              aria-label="{{ block.settings.handle | default: section.settings.title | escape }}"
            ></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
{
  "name": "Community gallery",
  "class": "index-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "As worn"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Spacing between images",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show section divider",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Credit / handle",
          "info": "Example: @thomas.paris"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Linked product",
          "info": "Makes the photo shoppable"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Used only if no product is selected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
