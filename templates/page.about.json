    "about-manifesto": {
      "type": "club-manifesto",
      "settings": {
        "quote": "<p>We do not follow trends. We follow conviction. FredJo exists for those who move with presence, confidence and no apologies. This is not streetwear for everyone. It is streetwear for those who already know.</p>",
        "attribution": "— FredJo, Paris",
        "bg": "#f5f4f0",
        "fg": "#0a0a0a"
      }
    },
    "about-standard": {
      "type": "club-editorial-split",
      "settings": {
        "image": "shopify://shop_images/unisex-oversized-heavyweight-hoodie-white-back-694d79873d2d3.jpg",
        "image_side": "left",
        "eyebrow": "The Standard",
        "title": "Refined in Paris. Built to last.",
        "body": "<p>Heavyweight cotton. Structured cuts. Triple-stitched seams. Every piece is designed in Paris and made to outlast the season — and the next one.</p><p>No fast fashion. No noise. Garments built to be worn like a decision.</p>",
        "pull_quote": "Wear it like a decision."
      }
